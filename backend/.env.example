# ---- Backend (FastAPI) configuration -------------------------------------
# Copy to backend/.env for local development. Never commit the real file.

ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies are first-party (the Next.js app proxies /api), so Lax works everywhere.
COOKIE_SECURE=false                # true in production (HTTPS)
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=true           # read client IP from X-Forwarded-For (for rate limiting)

CORS_ORIGINS=http://localhost:3000

# Optional first admin, created on startup only if no admin exists yet.
# Prefer `python -m app.scripts.create_admin` and leave these empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mohammed Sakib Hasan

# Media storage: local (dev) or cloudinary (production)
STORAGE_BACKEND=local
CLOUDINARY_URL=                    # cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=portfolio
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=15

# Public site revalidation webhook (must match the frontend's REVALIDATE_SECRET)
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CONTACT_PER_HOUR=5

# Optional e-mail notification for new contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAIL=sakibnghs123@gmail.com
