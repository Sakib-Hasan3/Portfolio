# --- AI assistant ("Ask Sakib's AI") -------------------------------------------------
# Get a free key at https://console.groq.com . Without a key the assistant still works in
# a limited "quote the portfolio" mode. Keys are read by the API only, never sent to the browser.
GROQ_API_KEY=
# Optional alternatives (pick the provider/model in Admin -> AI assistant):
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# Optional real semantic embeddings (default is a built-in local embedder; no key needed):
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
