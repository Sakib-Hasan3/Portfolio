# ---- Frontend (Next.js) configuration -------------------------------------
# Copy to frontend/.env.local for development. On Vercel, set these in Project Settings.

# Where the Next.js server reaches FastAPI. Server-side only — never exposed to browsers.
API_INTERNAL_URL=http://localhost:8000

# Public URL of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the backend; protects POST /api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret

# Fallback cache lifetime for public content, in seconds (tag revalidation makes updates instant)
CONTENT_REVALIDATE_SECONDS=3600
